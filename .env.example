# LATENT Production Environment Variables Configuration
SECRET_KEY=latent-production-super-secret-key-change-in-prod-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DATABASE_URL=sqlite:///./latent.db
RATE_LIMIT_PER_MINUTE=120
MAX_UPLOAD_SIZE_MB=5

# Live Gmail / SMTP Dispatch Configuration
# To send verification OTPs dynamically to real Gmail accounts:
# 1. Enable 2-Step Verification in Google Account
# 2. Generate an App Password under Security -> App Passwords
# 3. Enter your Gmail and 16-character App Password below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
